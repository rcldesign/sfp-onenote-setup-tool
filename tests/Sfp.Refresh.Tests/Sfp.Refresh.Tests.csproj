<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sfp.Core/Sfp.Core.csproj" />
    <ProjectReference Include="../../src/Sfp.OneNote/Sfp.OneNote.csproj" />
    <ProjectReference Include="../../src/Sfp.Refresh/Sfp.Refresh.csproj" />
    <!-- The refresh verb (M4.7) is tested here through RefreshCommand.Run with TextWriters; no separate CLI test project exists. -->
    <ProjectReference Include="../../src/Sfp.Cli/Sfp.Cli.csproj" />
    <ProjectReference Include="../Sfp.TestSupport/Sfp.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OneNote tests' small JSON Schema checker, linked (not copied) so a sidecar Refresh saves is validated against
         the same tests/Sfp.OneNote.Tests/schema/sfp-state.schema.json. -->
    <Compile Include="../Sfp.OneNote.Tests/Support/JsonSchemaLite.cs" Link="Support/JsonSchemaLite.cs" />
  </ItemGroup>
</Project>
