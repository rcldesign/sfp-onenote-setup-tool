{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rcldesign/sfp-onenote-setup-tool/schema/sfp-state.schema.json",
  "title": "sfp2onenote sidecar (sfp-state.json)",
  "description": "Written beside a generated notebook folder as {NotebookFolder}.sfp-state.json: the tool version, the manifest id, the quarter, the notebook's OneNote ids and a map from page key to its page id, section id and tool-owned anchor object ids. Refresh reads it to find the objects it may edit; it is rebuilt from the notebook's sfp.key metas when missing.",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolVersion",
    "manifestId",
    "quarter",
    "notebookName",
    "notebookPath",
    "notebookId",
    "sections",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "quarter": { "$ref": "#/definitions/quarterSpec" },
    "notebookName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "notebookPath": { "type": "string", "minLength": 1 },
    "notebookId": { "type": "string", "minLength": 1 },
    "sections": {
      "description": "Plan section name to OneNote section ID.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "sectionGroups": {
      "description": "Section group name (Weeks with --group-weeks) to OneNote section group ID; empty, or absent in older files, for a notebook without groups.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "pages": {
      "description": "Page key (cover, day:2027-01-04, week:02:overview ...) to its ids.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+(:[A-Za-z0-9-]+)*$" },
      "additionalProperties": { "$ref": "#/definitions/page" }
    },
    "generated": { "type": "string", "format": "date-time" },
    "lastRefresh": { "type": "string", "format": "date-time" },
    "frozenThrough": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "previousNotebook": { "type": "string" },
    "timeBlocks": { "$ref": "#/definitions/timeBlockWindow" }
  },
  "definitions": {
    "timeBlockWindow": {
      "description": "The Time Blocks window the daily pages were generated with: first row hour and the hour after the last row, 24-hour clock. Absent in files written before it was recorded.",
      "type": "object",
      "required": [ "startHour", "endHour" ],
      "additionalProperties": false,
      "properties": {
        "startHour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "endHour": { "type": "integer", "minimum": 1, "maximum": 24 },
        "rowCount": { "type": "integer", "minimum": 1, "maximum": 24 },
        "isValid": { "type": "boolean" }
      }
    },
    "quarterSpec": {
      "type": "object",
      "required": [ "year", "month" ],
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 2199 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "isOnCycle": { "type": "boolean" }
      }
    },
    "page": {
      "type": "object",
      "required": [ "pageId", "sectionId" ],
      "additionalProperties": false,
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "anchors": {
          "description": "Anchor or slot id (dailyDate, calendarDay:2027-01-04, objectiveLegend ...) to the objectID of the outline the tool wrote.",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "anchorTexts": {
          "description": "Slot id to the text Refresh last wrote in that slot's outline, so a later run can tell the user edited it; absent or empty in older files.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
