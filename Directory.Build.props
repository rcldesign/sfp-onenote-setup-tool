<Project>
  <!-- Shared build settings for every project in the solution.
       Rules from the development plan: nullable on, warnings as errors, analyzers on, net8.0 everywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- A machine with only a newer SDK and runtime (global.json rolls forward to the latest major) still builds and
         runs the net8.0 projects: the test hosts and tools roll forward to the installed runtime. The release
         executables are self-contained and carry the .NET 8 runtime regardless. -->
    <RollForward>Major</RollForward>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- RootNamespace and AssemblyName are left to MSBuild's defaults (the project name). Setting them here broke the
         WPF app under the .NET 9 SDK: the markup compiler's temporary assembly project re-imports this file after its
         own properties, so the explicit AssemblyName renamed the temporary assembly and every local XAML type went
         missing (MC3074). -->
    <Version>1.0.0</Version>
    <Authors>Topher Williams</Authors>
    <Company>TEW Group, LLC</Company>
    <Product>sfp2onenote</Product>
    <Copyright>Copyright 2026 TEW Group, LLC</Copyright>
    <RepositoryUrl>https://github.com/rcldesign/sfp-onenote-setup-tool</RepositoryUrl>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Building the Windows-only projects (WPF app) on Linux or macOS is allowed for compile checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Let test projects and tools skip the repository-wide expectations that only apply to shipped code. -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Paths every project can use to find shared repository content. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <TemplatesDir>$(RepoRoot)templates/</TemplatesDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <!-- xUnit analyzers flag a handful of patterns that are fine in this repository; keep warnings as errors otherwise. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1515</NoWarn>
  </PropertyGroup>
</Project>
