<UserControl x:Class="Sfp.App.Views.GenerateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sfp.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">
    <!-- PRD error table: "Font missing: warning banner, fallback font in use". Hidden when the typeface is installed. -->
    <TextBlock Style="{StaticResource WarningText}" Text="{Binding FontWarning}" Margin="0,0,0,8"
               AutomationProperties.Name="Fallback font in use" />
    <!-- Fields, Advanced and previews lock while a run is on; the Cancel button below stays live. -->
    <StackPanel IsEnabled="{Binding FieldsEnabled}">

      <!-- Fields per the PRD main screen table -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Template PDF" />
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="_Browse..." Command="{Binding BrowsePdfCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="Browse for the template PDF" />
            <TextBox Text="{Binding PdfPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template PDF path" />
          </DockPanel>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PdfError}" />
          <TextBlock Style="{StaticResource PendingText}" Text="{Binding PdfPending}" />
          <TextBlock Style="{StaticResource WarningText}" Text="{Binding PdfWarning}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Quarter start month" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
          <StackPanel Orientation="Horizontal">
            <ComboBox Width="160" ItemsSource="{Binding Months}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Month}" AutomationProperties.Name="Start month" />
            <TextBox Width="80" Margin="8,0,0,0" Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Start year" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="The day is always the 1st." />
          </StackPanel>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding StartError}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Notebook name" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
          <TextBox Text="{Binding NotebookName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Notebook name" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding NameError}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Output folder" />
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="B_rowse..." Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="Browse for the output folder" />
            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output folder" />
          </DockPanel>
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FolderError}" />
          <TextBlock Style="{StaticResource WarningText}" Text="{Binding FolderWarning}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Date format" />
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" Width="200"
                  ItemsSource="{Binding DateFormats}" DisplayMemberPath="Label" SelectedItem="{Binding DateFormat}"
                  AutomationProperties.Name="Date format" />

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Weeks remaining" />
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" Width="300"
                  ItemsSource="{Binding WeeksRemainingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding WeeksRemaining}" AutomationProperties.Name="Weeks remaining mode" />

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Calendar months" />
        <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" Width="200" IsEnabled="False"
                  ItemsSource="{Binding CalendarMonthChoices}" SelectedItem="{Binding CalendarMonths, Mode=OneWay}"
                  AutomationProperties.Name="Calendar months (fixed at three)" />

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Render DPI" />
        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,4">
          <ComboBox HorizontalAlignment="Left" Width="120" ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding Dpi}"
                    AutomationProperties.Name="Render DPI" />
          <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DpiError}" />
          <TextBlock Text="{Binding SizeEstimate}" Margin="0,2,0,0" AutomationProperties.Name="Notebook size estimate" />
        </StackPanel>
      </Grid>

      <!-- Advanced options -->
      <Expander Header="Advanced" Margin="0,8,0,0" AutomationProperties.Name="Advanced options">
        <Grid Margin="16,4,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding GroupWeeks}"
                    Content="Group the week sections in one Weeks section group" AutomationProperties.Name="Group weeks" />
          <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding Links}"
                    Content="Page links (off gives a purely locked sheet)" AutomationProperties.Name="Page links" />
          <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding HideTitle}"
                    Content="Hide page titles (pages then show as Untitled page)" AutomationProperties.Name="Hide page titles" />
          <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding CustomPageSize}"
                    Content="Custom page size, 1112 x 770 pt (for printing; the iPad ignores it)" AutomationProperties.Name="Custom page size" />

          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Page scale" />
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
            <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding PageScaleText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Page scale" />
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PageScaleError}" />
          </StackPanel>

          <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Six-row months" />
          <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" Width="260"
                    ItemsSource="{Binding SixthRowChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding SixthRow}" AutomationProperties.Name="Six-row month handling" />

          <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Out-of-month days" />
          <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left" Width="260"
                    ItemsSource="{Binding OutOfMonthDayChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding OutOfMonthDays}" AutomationProperties.Name="Out-of-month day style" />

          <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding ReflectionDateIsWeekStart}"
                    Content="Reflection date = week start (Monday instead of Sunday)" AutomationProperties.Name="Reflection date is week start" />
          <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding IncludeOutOfQuarterDays}"
                    Content="Include the days of the first and last week that fall outside the quarter" AutomationProperties.Name="Include out-of-quarter days" />

          <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Time-block window" />
          <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="from" Margin="0,0,6,0" />
              <ComboBox Width="70" ItemsSource="{Binding StartHours}" SelectedItem="{Binding TimeBlockStart}" AutomationProperties.Name="Time-block window start hour" />
              <TextBlock VerticalAlignment="Center" Text="to" Margin="8,0,6,0" />
              <ComboBox Width="70" ItemsSource="{Binding EndHours}" SelectedItem="{Binding TimeBlockEnd}" AutomationProperties.Name="Time-block window end hour" />
              <TextBlock VerticalAlignment="Center" Text="(24-hour clock, end exclusive)" Margin="8,0,0,0"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding TimeBlocksError}" />
          </StackPanel>

          <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Previous notebook" />
          <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Bro_wse..." Command="{Binding BrowsePreviousCommand}" Margin="8,0,0,0"
                      AutomationProperties.Name="Browse for the previous quarter's notebook" />
              <TextBox Text="{Binding PreviousNotebook, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Previous notebook" />
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Optional: the last quarter's notebook folder. Its Quarterly Review gets a Next quarter link to this notebook." />
          </StackPanel>
        </Grid>
      </Expander>

      <!-- Preview strip -->
      <TextBlock Style="{StaticResource SectionHeading}" Text="Preview" />
      <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Previews.Status}" />
      <ItemsControl ItemsSource="{Binding Previews.Thumbnails}" AutomationProperties.Name="Preview strip">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Margin="0,0,8,0" Padding="6">
              <StackPanel>
                <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Grid MinHeight="160">
                  <Image Source="{Binding Png, Converter={StaticResource PngImage}}" Stretch="Uniform" MaxHeight="220"
                         Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="{Binding Caption}" />
                  <TextBlock Style="{StaticResource PendingText}" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

      <!-- Generate button and the run -->
      <Button Content="_Generate" HorizontalAlignment="Left" Margin="0,12,0,4" Command="{Binding GenerateCommand}" IsDefault="True"
              AutomationProperties.Name="Generate the notebook" />
      <local:GenerateRunView DataContext="{Binding Run}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
