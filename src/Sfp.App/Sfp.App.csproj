<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF window: Generate tab, Refresh tab. No logic in the UI layer: the view models, validators and service seams live
       in the nested net8.0 library Sfp.App.ViewModels (excluded from this project's globs) so they build and test on any OS.
       This project holds XAML, the composition root (Composition/AppServices.cs) and the OS-facing service implementations. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>sfp2onenote-app</AssemblyName>
    <RootNamespace>Sfp.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);Sfp.App.ViewModels/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Sfp.App.ViewModels/**" />
    <None Remove="Sfp.App.ViewModels/**" />
    <Page Remove="Sfp.App.ViewModels/**" />
    <EmbeddedResource Remove="Sfp.App.ViewModels/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Sfp.App.ViewModels/Sfp.App.ViewModels.csproj" />
    <ProjectReference Include="../Sfp.Core/Sfp.Core.csproj" />
    <ProjectReference Include="../Sfp.Render/Sfp.Render.csproj" />
    <ProjectReference Include="../Sfp.OneNote/Sfp.OneNote.csproj" />
    <ProjectReference Include="../Sfp.Refresh/Sfp.Refresh.csproj" />
    <ProjectReference Include="../Sfp.Cli/Sfp.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TemplatesDir)**/*" Link="templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Publishing (build/publish.sh, build/publish.ps1): a self-contained single-file win-x64 sfp2onenote-app.exe in the
         same release folder as sfp2onenote.exe, which the daily scheduled task runs. Never trimmed: WPF is not
         trim-safe. Symbols and XML documentation stay out of the release folder. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- The referenced projects' .pdb files and the native libSkiaSharp.pdb (89 MB) of the SkiaSharp package. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <!-- The SDK hands a referenced executable's runtimeconfig.json and deps.json to the referencing project. The
           sfp2onenote.exe in the release folder is a single-file bundle with its own, so a loose copy is only clutter. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'sfp2onenote.runtimeconfig.json' or '%(RelativePath)' == 'sfp2onenote.deps.json'" />
    </ItemGroup>
  </Target>
</Project>
