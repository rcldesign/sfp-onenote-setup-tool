<Window x:Class="Sfp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sfp.App.Views"
        Title="{Binding Title}" Height="820" Width="1040" MinHeight="600" MinWidth="820">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource WarningText}" Text="{Binding Notice}" Margin="0,0,0,8"
               AutomationProperties.Name="Startup notice" />
    <TabControl SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.Name="Main tabs">
      <TabItem Header="_Generate" AutomationProperties.Name="Generate tab">
        <views:GenerateView DataContext="{Binding Generate}" />
      </TabItem>
      <TabItem Header="_Refresh" AutomationProperties.Name="Refresh tab">
        <views:RefreshView DataContext="{Binding Refresh}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
