<Project Sdk="Microsoft.NET.Sdk">
  <!-- sfp2onenote.exe verbs: plan, generate, refresh, render-only, measure. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>sfp2onenote</AssemblyName>
    <RootNamespace>Sfp.Cli</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sfp.Core/Sfp.Core.csproj" />
    <ProjectReference Include="../Sfp.Render/Sfp.Render.csproj" />
    <ProjectReference Include="../Sfp.OneNote/Sfp.OneNote.csproj" />
    <ProjectReference Include="../Sfp.Refresh/Sfp.Refresh.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The generate verb's tests live in Sfp.OneNote.Tests (the CLI has no test project); they reach the refresh
         composition's resource seam (RefreshCommand.Compose). -->
    <InternalsVisibleTo Include="Sfp.OneNote.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>
  <ItemGroup>
    <!-- The templates folder ships beside the executable. -->
    <None Include="$(TemplatesDir)**/*" Link="templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Publishing (build/publish.sh, build/publish.ps1): a self-contained single-file win-x64 sfp2onenote.exe in the
         release folder, templates beside it. Never trimmed: the app is WPF, which is not trim-safe, and both executables
         carry the same libraries. Symbols and XML documentation stay out of the release folder. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- The referenced projects' .pdb files and the native libSkiaSharp.pdb (89 MB) of the SkiaSharp package would
         otherwise land loose beside the single-file executable. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
