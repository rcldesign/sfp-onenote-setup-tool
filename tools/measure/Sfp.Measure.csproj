<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps PDF geometry (text runs with positions and sizes, line segments) to compare against the manifest. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>sfp-measure</AssemblyName>
    <RootNamespace>Sfp.Measure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sfp.Core/Sfp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" />
  </ItemGroup>
</Project>
